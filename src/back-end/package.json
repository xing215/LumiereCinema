{
  "name": "lumiere-backend",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently \"redis-server.exe\" \"nodemon app.js\"",
    "test-rag": "node testRAGSetup.js",
    "generate-embeddings": "node scripts/generateInitialEmbeddings.js",
    "rag-setup": "npm run test-rag && npm run generate-embeddings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:controllers": "prettier --write controllers/**/*.js",
    "format:models": "prettier --write models/**/*.js",
    "format:routes": "prettier --write routes/**/*.js",
    "format:utils": "prettier --write utils/**/*.js",
    "lint:fix": "prettier --write . && echo Formatting completed!"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.8.7",
    "nanoid": "^3.3.11",
    "nodemailer": "^7.0.5",
    "password-validator": "^5.3.0",
    "qrcode": "^1.5.1",
    "redis": "^5.5.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
