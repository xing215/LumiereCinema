{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "as-needed",
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.js",
            "options": {
                "parser": "babel"
            }
        },
        {
            "files": "*.json",
            "options": {
                "parser": "json",
                "tabWidth": 2
            }
        },
        {
            "files": "*.html",
            "options": {
                "parser": "html",
                "tabWidth": 2,
                "htmlWhitespaceSensitivity": "css"
            }
        },
        {
            "files": "*.md",
            "options": {
                "parser": "markdown",
                "tabWidth": 2,
                "proseWrap": "preserve"
            }
        }
    ]
}
